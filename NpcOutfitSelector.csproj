<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableHarmony>false</EnableHarmony>
    <!-- Deployed folder/display name only — UniqueID, EntryDll, and the C# namespace stay
         NpcOutfitSelector so existing installs/config aren't affected by this. -->
    <ModFolderName>Dynamic NPC Outfit Selector</ModFolderName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Auto-references the game DLLs and copies the built mod into your Mods folder.
         Update the version if a newer one is out: https://www.nuget.org/packages/Pathoschild.Stardew.ModBuildConfig -->
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
  </ItemGroup>

</Project>
